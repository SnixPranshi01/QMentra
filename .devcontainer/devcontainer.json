{
  "name": "QMentra Quantum Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [
    5173,
    8000,
    5433
  ],
  "portsAttributes": {
    "5173": {
      "label": "QMentra web",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "QMentra API",
      "onAutoForward": "notify"
    },
    "5433": {
      "label": "QMentra PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci && python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "postAttachCommand": "if ! curl -fsS http://localhost:5173 >/dev/null; then (npm run dev -- --host 0.0.0.0 > /tmp/qmentra-vite.log 2>&1 &); fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.trimTrailingWhitespace": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}